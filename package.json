{
  "name": "fittrack",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "analyze": "ANALYZE=true npm run build",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "postbuild": "npm run security-check",
    "security-check": "if grep -qr 'sk-ant' dist/ 2>/dev/null; then echo '🚨 CHAVE ANTHROPIC NO BUNDLE!' && exit 1; else echo '✅ Zero Trust OK: Nenhum segredo no frontend.'; fi",
    "check-jwt": "bash scripts/check-jwt-secret.sh",
    "validate-exercises": "node scripts/validate-exercise-db.js",
    "lint": "eslint src --ext .js,.jsx,.ts,.tsx",
    "preview:host": "vite preview --host 0.0.0.0",
    "download-exercises": "node scripts/downloadAllExerciseMedia.js",
    "generate-placeholders": "node scripts/generateSvgPlaceholders.js",
    "generate-gifs": "node scripts/generateExerciseGifs.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@capacitor/core": "^6.0.0",
    "@capacitor/haptics": "^6.0.0",
    "@google/generative-ai": "^0.21.0",
    "@mediapipe/camera_utils": "^0.3.1675466862",
    "@mediapipe/pose": "^0.5.1675469404",
    "@mediapipe/tasks-vision": "^0.10.34",
    "@pinecone-database/pinecone": "^8.0.0",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.5.0",
    "@sentry/react": "^10.48.0",
    "@supabase/supabase-js": "^2.103.2",
    "@types/three": "^0.183.1",
    "cors": "^2.8.6",
    "date-fns": "^4.1.0",
    "dompurify": "^3.4.2",
    "express": "^4.22.2",
    "framer-motion": "^12.38.0",
    "idb": "^8.0.3",
    "idb-keyval": "^6.2.2",
    "lodash": "^4.18.1",
    "lucide-react": "^1.8.0",
    "node-cron": "^4.6.0",
    "posthog-js": "^1.404.1",
    "react": "^19.2.4",
    "react-calendar": "^6.0.1",
    "react-confetti": "^6.4.0",
    "react-dom": "^19.2.4",
    "react-hook-form": "^7.72.1",
    "recharts": "^3.8.1",
    "resend": "^6.17.2",
    "three": "^0.183.2",
    "use-long-press": "^3.3.0",
    "vite-plugin-compression": "^0.5.1",
    "zod": "^4.4.3",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@capacitor/android": "^6.0.0",
    "@capacitor/cli": "^6.0.0",
    "@capacitor/ios": "^6.0.0",
    "@eslint/js": "^9.39.4",
    "@tailwindcss/vite": "^4.3.1",
    "@types/cors": "^2.8.19",
    "@types/dompurify": "^3.2.0",
    "@types/express": "^5.0.6",
    "@types/node-cron": "^3.0.11",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.8",
    "@vitest/ui": "^4.1.8",
    "esbuild": "^0.28.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "jsdom": "^29.1.1",
    "rollup-plugin-visualizer": "^7.0.1",
    "tailwindcss": "^4.3.1",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.1",
    "vite": "^8.0.4",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.8"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "protobufjs@7.6.5": true,
    "core-js@3.49.0": true
  }
}
