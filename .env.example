# ═══════════════════════════════════════════════════════════════
# FitTrack V7 — Variáveis de Ambiente (SERVIDOR PROXY)
# ═══════════════════════════════════════════════════════════════
#
# ⚠️ REGRA ZERO TRUST:
#    NÃO uses o prefixo VITE_ para a API Key!
#    O Vite injeta VITE_* no bundle do cliente (browser).
#    Sem o prefixo, a variável fica APENAS no Node.js (segura).
#
# INSTRUÇÕES:
#   1. Copia este ficheiro para .env
#      cp .env.example .env
#   2. Substitui os valores dummy pela tua chave real
#   3. NUNCA faças commit do .env (já está no .gitignore)
# ═══════════════════════════════════════════════════════════════

# Chave da API Anthropic (Claude) — SÓ NO SERVIDOR
ANTHROPIC_API_KEY=sk-ant-api03-COLOCA-AQUI-A-TUA-CHAVE-REAL

# Segredo para assinar JWT — SÓ NO SERVIDOR
# Gera um com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
API_SHARED_SECRET=troca-por-uma-string-aleatoria-de-32-caracteres-minimo

# Porta do servidor proxy BFF
PORT=3001

# ═══════════════════════════════════════════════════════════════
# Variáveis do FRONTEND (com prefixo VITE_)
# Estas SÃO injetadas no browser — apenas URLs públicos!
# ═══════════════════════════════════════════════════════════════

# URL do servidor proxy (em dev, deixar vazio para usar Vite proxy)
# VITE_API_URL=http://localhost:3001

